# LLM 配置（provider 二选一）
# 方式一：OpenAI 兼容接口（DeepSeek / vLLM / Ollama / 各类网关）
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://api.deepseek.com/v1
#LLM_API_KEY=sk-xxx
#BASIC_MODEL_NAME=deepseek-chat
#REASONING_MODEL_NAME=deepseek-reasoner

# 方式二：Anthropic 原生协议
#LLM_PROVIDER=anthropic
#LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
#LLM_API_KEY=ark-xxx
#BASIC_MODEL_NAME=claude-sonnet-4-5
#REASONING_MODEL_NAME=claude-sonnet-4-5

# 防火墙日志文件路径（相对项目根目录或绝对路径）
LOG_FILE_PATH=data/firewall.log
